{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stitchwright.example/schema/strickschrift.schema.json",
  "title": "Stitchwright chart",
  "description": "Open chart format for Stitchwright. Rows are bottom-to-top; cells are left-to-right in the picture. The runtime validator in src/core/validate.js is authoritative.",
  "type": "object",
  "required": [
    "schema",
    "width",
    "height",
    "rows"
  ],
  "properties": {
    "schema": {
      "const": "strickschrift/1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": [
            "string",
            "null"
          ],
          "description": "null = knit / empty. A single-cell symbol id otherwise."
        }
      }
    },
    "colors": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "row",
          "col",
          "symbol"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "row": {
            "type": "integer",
            "minimum": 1
          },
          "col": {
            "type": "integer",
            "minimum": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "left": {
            "type": "integer",
            "minimum": 1
          },
          "right": {
            "type": "integer",
            "minimum": 1
          },
          "direction": {
            "enum": [
              "front",
              "back"
            ]
          },
          "span": {
            "type": "integer",
            "minimum": 1
          },
          "label": {
            "type": "string",
            "maxLength": 24
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "symbol": {
                  "const": "cable"
                }
              },
              "required": [
                "symbol"
              ]
            },
            "then": {
              "required": [
                "left",
                "right",
                "direction"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "symbol": {
                  "const": "custom"
                }
              },
              "required": [
                "symbol"
              ]
            },
            "then": {
              "required": [
                "span",
                "label"
              ]
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "palette": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "hex"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "hex": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "additionalProperties": false
      }
    },
    "options": {
      "type": "object",
      "properties": {
        "rowsMode": {
          "enum": [
            "all",
            "rs"
          ]
        },
        "showRowNumbers": {
          "type": "boolean"
        },
        "showStitchNumbers": {
          "type": "boolean"
        },
        "showLegend": {
          "type": "boolean"
        },
        "repeat": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "cellMm": {
          "type": "number",
          "minimum": 2,
          "maximum": 20
        },
        "paper": {
          "enum": [
            "A4",
            "A3",
            "Letter",
            "auto"
          ]
        },
        "subtitle": {
          "type": "string",
          "maxLength": 120
        }
      },
      "additionalProperties": true
    },
    "meta": {
      "type": "object",
      "properties": {
        "author": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "modified": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
